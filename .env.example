# ============================================================================
# Arise — Environment configuration
# Copy to .env (gitignored) and fill in real values.
# On Hostinger, set these in hPanel instead of uploading a .env file.
# ============================================================================

# --- Server ---
# Hostinger sets PORT automatically for Node.js apps — do not hardcode it in
# production. Defaults to 4000 locally.
PORT=4000
NODE_ENV=production

# --- MySQL ---
# Hostinger gives you these values when you create a MySQL database in hPanel:
# Databases -> Management -> Create new database.
DB_HOST=replace-with-hostinger-mysql-host
DB_PORT=3306
DB_USER=replace-me
DB_PASSWORD=replace-me
DB_NAME=replace-me
# DB_USERNAME and DB_DATABASE are also supported aliases for DB_USER and DB_NAME.

# Alternative: a full connection URL instead of DB_* (takes precedence).
# DATABASE_URL=mysql://user:password@host:3306/dbname

# Connection pool tuning
DB_POOL_MAX=10
DB_POOL_IDLE=10
DB_POOL_IDLE_TIMEOUT=60000
DB_POOL_QUEUE_LIMIT=0

# --- Admin ---
# Long random string that protects admin endpoints (GET /api/volunteers).
# NEVER expose this to the frontend browser code or in any VITE_* variable.
ADMIN_API_KEY=replace-me-with-a-long-random-string

# --- Razorpay (server-side only) ---
# Configure test keys first, then replace with live keys for production.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me

# --- CORS (optional) ---
# Comma-separated list of allowed origins. Only needed if the frontend is
# hosted on a different origin than the API. Same-origin deployments can
# leave this empty.
# CORS_ORIGIN=https://example.com,https://www.example.com

# --- Frontend build-time variables (used by Vite) ---
# Set these in arise-site/.env (NOT in the root .env — Vite reads them from
# the arise-site directory and only VITE_* values are exposed to the build).
#   VITE_API_URL=/api
#   VITE_HERO_VIDEO_URL=/videos/arise-hero.mp4
#   VITE_PROMO_VIDEO_URL=/videos/arise-promo.mp4
#   VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
#   VITE_UPI_ID=
#   VITE_UPI_QR_URL=
#   VITE_UPI_DISPLAY_NAME=Arise Association
#   VITE_UPI_INSTRUCTIONS=Scan the QR code using your preferred UPI app.
#   VITE_PHYSICAL_DONATION_DETAILS=
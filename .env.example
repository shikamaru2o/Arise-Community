# For local testing only. On Hostinger, set these as environment variables
# in hPanel under your Node.js app's settings instead of uploading this file.

# Hostinger gives you these values when you create a MySQL database
# in hPanel: Databases -> Management -> Create new database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_arise
DB_PASSWORD=change-me
DB_NAME=u123456789_arise_volunteers

# Long random string that protects the admin endpoints (GET /api/volunteers)
ADMIN_API_KEY=change-me-to-a-long-random-string

# Hostinger sets PORT automatically for Node.js apps - do not hardcode it
# in production. Left here only for local `node server.js` testing.
PORT=4000
